<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>AquaBuzz Dashboard - Live Game Monitor</title>
    <style>
        * {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
        }
        
        body {
            font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, Oxygen, Ubuntu, Cantarell, sans-serif;
            background: #0a0e27;
            color: #e0e6ed;
            padding: 20px;
        }
        
        .container {
            max-width: 1600px;
            margin: 0 auto;
        }
        
        h1 {
            font-size: 2.5em;
            margin-bottom: 10px;
            background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
            -webkit-background-clip: text;
            -webkit-text-fill-color: transparent;
            background-clip: text;
        }
        
        .subtitle {
            color: #8b95a5;
            margin-bottom: 30px;
        }
        
        .grid {
            display: grid;
            grid-template-columns: repeat(auto-fit, minmax(320px, 1fr));
            gap: 20px;
            margin-bottom: 30px;
        }
        
        .grid-2col {
            display: grid;
            grid-template-columns: 1fr 1fr;
            gap: 20px;
            margin-bottom: 30px;
        }
        
        .card {
            background: #1a1f3a;
            border-radius: 12px;
            padding: 24px;
            box-shadow: 0 4px 6px rgba(0,0,0,0.3);
            border: 1px solid #2d3548;
        }
        
        .card-live {
            background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
            color: white;
        }
        
        .card h2 {
            font-size: 1.4em;
            margin-bottom: 20px;
            color: #e0e6ed;
            border-bottom: 2px solid #667eea;
            padding-bottom: 12px;
        }
        
        .card-live h2 {
            border-bottom-color: rgba(255,255,255,0.3);
            color: white;
        }
        
        .stat {
            display: flex;
            justify-content: space-between;
            padding: 12px 0;
            border-bottom: 1px solid #2d3548;
        }
        
        .stat:last-child {
            border-bottom: none;
        }
        
        .stat-label {
            color: #8b95a5;
            font-weight: 500;
        }
        
        .stat-value {
            font-weight: bold;
            color: #e0e6ed;
        }
        
        .card-live .stat {
            border-bottom-color: rgba(255,255,255,0.2);
        }
        
        .card-live .stat-label {
            color: rgba(255,255,255,0.8);
        }
        
        .card-live .stat-value {
            color: white;
            font-size: 1.1em;
        }
        
        .status-indicator {
            display: inline-block;
            width: 10px;
            height: 10px;
            border-radius: 50%;
            margin-right: 8px;
            animation: pulse 2s infinite;
        }
        
        @keyframes pulse {
            0%, 100% { opacity: 1; }
            50% { opacity: 0.5; }
        }
        
        .status-online {
            background: #2ecc71;
        }
        
        .status-offline {
            background: #e74c3c;
        }
        
        .status-warning {
            background: #f39c12;
        }
        
        .live-counter {
            font-size: 3em;
            font-weight: bold;
            text-align: center;
            padding: 20px 0;
            font-family: 'Courier New', monospace;
        }
        
        .leaderboard-entry {
            display: flex;
            justify-content: space-between;
            padding: 14px;
            margin-bottom: 10px;
            background: #0f1729;
            border-radius: 8px;
            border-left: 4px solid #667eea;
        }
        
        .leaderboard-entry:nth-child(1) {
            background: linear-gradient(90deg, #f1c40f 0%, #f39c12 100%);
            color: #0a0e27;
            font-weight: bold;
            border-left-color: #f1c40f;
        }
        
        .leaderboard-entry:nth-child(2) {
            background: linear-gradient(90deg, #95a5a6 0%, #7f8c8d 100%);
            color: #0a0e27;
            border-left-color: #bdc3c7;
        }
        
        .leaderboard-entry:nth-child(3) {
            background: linear-gradient(90deg, #e67e22 0%, #d35400 100%);
            color: white;
            border-left-color: #e67e22;
        }
        
        .run-item {
            padding: 12px;
            margin-bottom: 10px;
            background: #0f1729;
            border-radius: 8px;
            font-size: 0.95em;
            border-left: 3px solid #667eea;
        }
        
        .run-item-finished {
            border-left-color: #2ecc71;
        }
        
        .run-item-cancelled {
            border-left-color: #e74c3c;
            opacity: 0.6;
        }
        
        .badge {
            display: inline-block;
            padding: 4px 10px;
            border-radius: 12px;
            font-size: 0.75em;
            font-weight: bold;
            margin-left: 8px;
            text-transform: uppercase;
        }
        
        .badge-expert {
            background: #9b59b6;
            color: white;
        }
        
        .badge-intermediate {
            background: #3498db;
            color: white;
        }
        
        .badge-beginner {
            background: #95a5a6;
            color: white;
        }
        
        .badge-status {
            padding: 6px 12px;
            border-radius: 16px;
            font-size: 0.85em;
        }
        
        .badge-started {
            background: #3498db;
            color: white;
        }
        
        .badge-finished {
            background: #2ecc71;
            color: white;
        }
        
        .badge-cancelled {
            background: #e74c3c;
            color: white;
        }
        
        .alert {
            padding: 14px;
            margin-bottom: 20px;
            border-radius: 8px;
            background: #34495e;
            border-left: 4px solid #f39c12;
            color: #ecf0f1;
        }
        
        .refresh-btn {
            background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
            color: white;
            border: none;
            padding: 12px 24px;
            border-radius: 8px;
            cursor: pointer;
            font-size: 1em;
            margin-bottom: 20px;
            font-weight: 600;
            transition: transform 0.2s;
        }
        
        .refresh-btn:hover {
            transform: translateY(-2px);
        }
        
        .game-active {
            animation: glow 2s ease-in-out infinite;
        }
        
        @keyframes glow {
            0%, 100% {
                box-shadow: 0 0 20px rgba(102, 126, 234, 0.5);
            }
            50% {
                box-shadow: 0 0 40px rgba(102, 126, 234, 0.8);
            }
        }
        
        .empty-state {
            text-align: center;
            padding: 40px 20px;
            color: #8b95a5;
        }
        
        .empty-state-icon {
            font-size: 3em;
            margin-bottom: 10px;
        }
        
        @media (max-width: 768px) {
            .grid, .grid-2col {
                grid-template-columns: 1fr;
            }
            
            h1 {
                font-size: 1.8em;
            }
        }
    </style>
</head>
<body>
    <div class="container">
        <h1>🎮 AquaBuzz Live Dashboard</h1>
        <p class="subtitle">Real-time intelligent buzz-wire maze monitoring</p>
        
        <button class="refresh-btn" onclick="loadData()">🔄 Refresh Now</button>
        
        <div class="alert" id="status-alert" style="display: none;"></div>
        
        <!-- Live Game Status -->
        <div class="card card-live game-active" id="live-game-card" style="display: none;">
            <h2>🔴 LIVE GAME IN PROGRESS</h2>
            <div id="live-game-info"></div>
        </div>
        
        <!-- System Status Grid -->
        <div class="grid">
            <div class="card">
                <h2>⚡ System Health</h2>
                <div id="health-info">Loading...</div>
            </div>
            
            <div class="card">
                <h2>🏆 Top Scores</h2>
                <div id="leaderboard">Loading...</div>
            </div>
            
            <div class="card">
                <h2>📊 Recent Activity</h2>
                <div id="recent-runs">Loading...</div>
            </div>
        </div>
        
        <!-- Players and Details -->
        <div class="card">
            <h2>👥 Players & Performance</h2>
            <div id="players-list">Loading...</div>
        </div>
        
        <!-- Latest Run Details -->
        <div class="card" id="run-details-card" style="display: none;">
            <h2>📈 Latest Run Details</h2>
            <div id="run-details"></div>
        </div>
    </div>
    
    <script>
        // Auto-detect backend API URL
        const API_BASE = window.location.port ? 
            `http://localhost:8000/api` : 
            `${window.location.protocol}//${window.location.hostname}:8000/api`;
        
        let activeRuns = [];
        
        // FEAT-004: Dashboard latency measurement
        let lastEventTimestamp = null;
        let latencyStats = {
            apiLatency: [],
            renderLatency: []
        };
        
        // FEAT-009: Server-Sent Events for real-time updates
        let eventSource = null;
        let sseReconnectAttempts = 0;
        const SSE_MAX_RECONNECT_ATTEMPTS = 3;
        let useSseUpdates = true;  // Try SSE first, fallback to polling if it fails
        
        function connectSSE() {
            if (!useSseUpdates) return;
            
            try {
                console.log('[SSE] Connecting to live events stream...');
                eventSource = new EventSource(`${API_BASE}/live`);
                
                eventSource.onopen = () => {
                    console.log('[SSE] Connected to live events stream');
                    sseReconnectAttempts = 0;
                };
                
                eventSource.onmessage = (event) => {
                    try {
                        const data = JSON.parse(event.data);
                        handleLiveEvent(data);
                    } catch (err) {
                        console.error('[SSE] Error parsing event:', err);
                    }
                };
                
                eventSource.onerror = (error) => {
                    console.error('[SSE] Connection error:', error);
                    eventSource.close();
                    
                    sseReconnectAttempts++;
                    
                    if (sseReconnectAttempts >= SSE_MAX_RECONNECT_ATTEMPTS) {
                        console.log('[SSE] Max reconnection attempts reached, falling back to polling only');
                        useSseUpdates = false;
                        return;
                    }
                    
                    // Exponential backoff reconnection
                    const delay = Math.min(1000 * Math.pow(2, sseReconnectAttempts), 10000);
                    console.log(`[SSE] Reconnecting in ${delay}ms...`);
                    setTimeout(connectSSE, delay);
                };
            } catch (err) {
                console.error('[SSE] Failed to create EventSource:', err);
                useSseUpdates = false;
            }
        }
        
        function handleLiveEvent(event) {
            const eventType = event.event;
            console.log(`[SSE] Received ${eventType} event:`, event);
            
            // FEAT-009: Trigger immediate refresh on key events
            if (eventType === 'hit_start' || eventType === 'hit_end' || 
                eventType === 'run_start' || eventType === 'run_finish') {
                // Refresh data immediately without waiting for poll interval
                loadData();
            }
        }
        
        async function loadData() {
            // FEAT-004: Measure API fetch timing
            const fetchStart = performance.now();
            
            await Promise.all([
                loadHealth(),
                loadLeaderboard(),
                loadRecentRuns(),
                loadPlayers()
            ]);
            
            const fetchEnd = performance.now();
            const renderStart = performance.now();
            
            // Let browser render
            await new Promise(resolve => requestAnimationFrame(resolve));
            
            const renderEnd = performance.now();
            
            // FEAT-004: Track latency
            const apiFetchMs = fetchEnd - fetchStart;
            const renderMs = renderEnd - renderStart;
            
            latencyStats.apiLatency.push(apiFetchMs);
            latencyStats.renderLatency.push(renderMs);
            
            // Keep only last 20 measurements
            if (latencyStats.apiLatency.length > 20) latencyStats.apiLatency.shift();
            if (latencyStats.renderLatency.length > 20) latencyStats.renderLatency.shift();
            
            // FEAT-004: Console logging for debugging
            console.log(`[Dashboard] API fetch: ${apiFetchMs.toFixed(1)}ms, render: ${renderMs.toFixed(1)}ms`);
        }
        
        async function loadHealth() {
            try {
                const res = await fetch(`${API_BASE}/health`);
                const data = await res.json();
                
                // Update active runs indicator
                const previousActiveRuns = activeRuns;
                activeRuns = data.active_runs || 0;
                
                // FEAT-008: Update polling rate based on active games
                if (activeRuns !== previousActiveRuns) {
                    updatePollRate();
                }
                
                if (activeRuns > 0) {
                    document.getElementById('live-game-card').style.display = 'block';
                    document.getElementById('live-game-info').innerHTML = `
                        <div class="live-counter">${activeRuns}</div>
                        <div style="text-align: center; font-size: 1.2em;">
                            ${activeRuns === 1 ? 'Player in Action' : 'Players in Action'}
                        </div>
                    `;
                } else {
                    document.getElementById('live-game-card').style.display = 'none';
                }
                
                const mqttStatus = data.mqtt_connected ? 
                    '<span class="status-indicator status-online"></span>Connected' :
                    '<span class="status-indicator status-offline"></span>Disconnected';
                
                // Device status
                let deviceHtml = '';
                if (data.devices && data.devices.length > 0) {
                    data.devices.forEach(device => {
                        const devStatus = device.online ? 
                            '<span class="status-indicator status-online"></span>Online' :
                            '<span class="status-indicator status-offline"></span>Offline';
                        deviceHtml += `
                            <div class="stat">
                                <span class="stat-label">Device ${device.id}</span>
                                <span class="stat-value">${devStatus}</span>
                            </div>
                        `;
                    });
                } else {
                    deviceHtml = `
                        <div class="stat">
                            <span class="stat-label">ESP32 Device</span>
                            <span class="stat-value"><span class="status-indicator status-warning"></span>Waiting...</span>
                        </div>
                    `;
                }
                
                document.getElementById('health-info').innerHTML = `
                    <div class="stat">
                        <span class="stat-label">Backend API</span>
                        <span class="stat-value"><span class="status-indicator status-online"></span>Online</span>
                    </div>
                    <div class="stat">
                        <span class="stat-label">MQTT Broker</span>
                        <span class="stat-value">${mqttStatus}</span>
                    </div>
                    ${deviceHtml}
                    <div class="stat">
                        <span class="stat-label">Games Playing</span>
                        <span class="stat-value">${activeRuns}</span>
                    </div>
                    <div class="stat">
                        <span class="stat-label">Total Completed</span>
                        <span class="stat-value">${data.completed_runs || 0}</span>
                    </div>
                `;
            } catch (err) {
                console.error('Backend connection error:', err);
                document.getElementById('health-info').innerHTML = `
                    <div class="empty-state">
                        <div class="empty-state-icon">❌</div>
                        <div>Cannot connect to backend</div>
                        <div style="font-size: 0.9em; margin-top: 10px;">${API_BASE}</div>
                    </div>
                `;
            }
        }
        
        async function loadLeaderboard() {
            try {
                const res = await fetch(`${API_BASE}/leaderboard?limit=5`);
                const data = await res.json();
                
                if (data.length === 0) {
                    document.getElementById('leaderboard').innerHTML = `
                        <div class="empty-state">
                            <div class="empty-state-icon">🏆</div>
                            <div>No completed runs yet</div>
                            <div style="font-size: 0.9em; margin-top: 5px;">Start playing to see scores!</div>
                        </div>
                    `;
                    return;
                }
                
                const html = data.map(entry => `
                    <div class="leaderboard-entry">
                        <span>${entry.rank}. ${entry.player_id}</span>
                        <span>${(entry.score / 1000).toFixed(2)}s (${entry.hits} hits)</span>
                    </div>
                `).join('');
                
                document.getElementById('leaderboard').innerHTML = html;
            } catch (err) {
                document.getElementById('leaderboard').innerHTML = '<div class="empty-state">Error loading leaderboard</div>';
            }
        }
        
        async function loadRecentRuns() {
            try {
                const res = await fetch(`${API_BASE}/runs?limit=10`);
                const data = await res.json();
                
                if (data.length === 0) {
                    document.getElementById('recent-runs').innerHTML = `
                        <div class="empty-state">
                            <div class="empty-state-icon">📊</div>
                            <div>No activity yet</div>
                        </div>
                    `;
                    return;
                }
                
                const html = data.map(run => {
                    const statusBadge = run.status === 'finished' ? 
                        '<span class="badge badge-finished">Finished</span>' :
                        run.status === 'started' ?
                        '<span class="badge badge-started">In Progress</span>' :
                        '<span class="badge badge-cancelled">Cancelled</span>';
                    
                    const itemClass = run.status === 'finished' ? 'run-item-finished' :
                                     run.status === 'cancelled' ? 'run-item-cancelled' : '';
                    
                    return `
                        <div class="run-item ${itemClass}">
                            <div><strong>${run.player_id}</strong> ${statusBadge}</div>
                            <div style="margin-top: 5px; font-size: 0.9em;">
                                ${run.hits} hits • 
                                ${run.duration_ms ? (run.duration_ms / 1000).toFixed(2) + 's' : 'In progress'}
                                ${run.score ? ' • Score: ' + (run.score / 1000).toFixed(2) + 's' : ''}
                            </div>
                        </div>
                    `;
                }).join('');
                
                document.getElementById('recent-runs').innerHTML = html;
                
                // Show details for most recent completed run
                const latestFinished = data.find(r => r.status === 'finished');
                if (latestFinished) {
                    loadRunDetails(latestFinished.id);
                }
            } catch (err) {
                document.getElementById('recent-runs').innerHTML = '<div class="empty-state">Error loading runs</div>';
            }
        }
        
        async function loadRunDetails(runId) {
            try {
                const res = await fetch(`${API_BASE}/runs/${runId}`);
                const run = await res.json();
                
                document.getElementById('run-details-card').style.display = 'block';
                
                let hitsHtml = '';
                if (run.hit_records && run.hit_records.length > 0) {
                    // FEAT-007: Show in-progress vs completed hits differently
                    hitsHtml = run.hit_records.map(hit => {
                        if (hit.duration_ms === 0) {
                            // In-progress hit
                            return `
                                <div class="stat" style="background: rgba(239, 68, 68, 0.1); border-left: 3px solid #ef4444;">
                                    <span class="stat-label">🔴 Hit #${hit.hit_no} (IN PROGRESS)</span>
                                    <span class="stat-value">
                                        Started at ${(hit.start_ms / 1000).toFixed(2)}s
                                    </span>
                                </div>
                            `;
                        } else {
                            // Completed hit
                            return `
                                <div class="stat">
                                    <span class="stat-label">✓ Hit #${hit.hit_no}</span>
                                    <span class="stat-value">
                                        ${(hit.start_ms / 1000).toFixed(2)}s → ${(hit.duration_ms).toFixed(0)}ms contact
                                    </span>
                                </div>
                            `;
                        }
                    }).join('');
                } else {
                    hitsHtml = '<div class="empty-state">Perfect run - no hits!</div>';
                }
                
                document.getElementById('run-details').innerHTML = `
                    <div class="stat">
                        <span class="stat-label">Player</span>
                        <span class="stat-value">${run.player_id}</span>
                    </div>
                    <div class="stat">
                        <span class="stat-label">Total Time</span>
                        <span class="stat-value">${(run.duration_ms / 1000).toFixed(2)}s</span>
                    </div>
                    <div class="stat">
                        <span class="stat-label">Total Hits</span>
                        <span class="stat-value">${run.hits}</span>
                    </div>
                    <div class="stat">
                        <span class="stat-label">Total Contact Time</span>
                        <span class="stat-value">${(run.total_contact_ms / 1000).toFixed(2)}s</span>
                    </div>
                    <div class="stat">
                        <span class="stat-label">Longest Hit</span>
                        <span class="stat-value">${(run.longest_hit_ms).toFixed(0)}ms</span>
                    </div>
                    <div class="stat">
                        <span class="stat-label">Final Score</span>
                        <span class="stat-value">${(run.score / 1000).toFixed(2)}s</span>
                    </div>
                    <h3 style="margin-top: 20px; margin-bottom: 10px; color: #667eea;">Individual Hits</h3>
                    ${hitsHtml}
                `;
            } catch (err) {
                console.error('Error loading run details:', err);
            }
        }
        
        async function loadPlayers() {
            try {
                const res = await fetch(`${API_BASE}/players`);
                const data = await res.json();
                
                if (data.length === 0) {
                    document.getElementById('players-list').innerHTML = `
                        <div class="empty-state">
                            <div class="empty-state-icon">👥</div>
                            <div>No players yet</div>
                        </div>
                    `;
                    return;
                }
                
                const html = data.map(player => {
                    const badgeClass = player.skill_level ? 
                        `badge badge-${player.skill_level}` : '';
                    const skillBadge = player.skill_level ?
                        `<span class="${badgeClass}">${player.skill_level}</span>` : '';
                    
                    return `
                        <div class="stat">
                            <span class="stat-label">
                                ${player.id} ${skillBadge}
                            </span>
                            <span class="stat-value">
                                ${player.total_runs} runs
                                ${player.best_score ? ` • Best: ${(player.best_score / 1000).toFixed(2)}s` : ''}
                                ${player.avg_score ? ` • Avg: ${(player.avg_score / 1000).toFixed(2)}s` : ''}
                            </span>
                        </div>
                    `;
                }).join('');
                
                document.getElementById('players-list').innerHTML = html;
            } catch (err) {
                document.getElementById('players-list').innerHTML = '<div class="empty-state">Error loading players</div>';
            }
        }
        
        // FEAT-008: Adaptive polling rate
        let pollInterval = 3000;  // Start at 3 seconds
        let intervalId = null;
        let lastActiveCheck = 0;
        
        function updatePollRate() {
            const newInterval = (activeRuns > 0) ? 1000 : 3000;  // 1s during games, 3s idle
            
            if (newInterval !== pollInterval) {
                pollInterval = newInterval;
                console.log(`[Dashboard] Polling rate changed to ${pollInterval}ms (active runs: ${activeRuns})`);
                
                // Restart interval with new rate
                if (intervalId) clearInterval(intervalId);
                intervalId = setInterval(loadData, pollInterval);
            }
        }
        
        // Start adaptive polling
        intervalId = setInterval(loadData, pollInterval);
        
        // FEAT-009: Connect to SSE for real-time updates
        connectSSE();
        
        // Initial load
        loadData();
    </script>
</body>
</html>
